{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:continuum-attest:verification-result:v1",
  "title": "Attest native receipt-file verification result v1",
  "description": "One receipt-file record emitted by attest verify --format json, excluding archive and interop results. Structural validity does not authorize an artifact: consumers must enforce their own signer, receipt, check and warning policies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt",
    "verdict",
    "checks",
    "signed_by",
    "warnings"
  ],
  "properties": {
    "receipt": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "signed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "detail"
        ],
        "properties": {
          "name": {
            "enum": [
              "schema",
              "consistency",
              "signature",
              "timestamp",
              "recompute"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skipped"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "schema"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "consistency"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "signature"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "timestamp"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "recompute"
              }
            }
          }
        }
      ]
    }
  }
}
